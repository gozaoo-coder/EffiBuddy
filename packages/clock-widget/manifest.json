{
  "id": "com.desktopsuite.clock",
  "name": "Clock Widget",
  "version": "0.1.0",
  "core_version": ">=0.1.0",
  "description": "A minimal always-on clock widget. First reference plugin proving the Core + plugin load chain.",
  "author": "Desktop Suite",
  "permissions": ["none"],
  "entry": {
    "backend": "clock_widget.dll",
    "frontend": "index.ts"
  },
  "widgets": [
    {
      "type": "analog",
      "name": "Analog Clock",
      "default_size": [200, 200]
    },
    {
      "type": "digital",
      "name": "Digital Clock",
      "default_size": [240, 80]
    }
  ],
  "hooks": {},
  "signature": null
}
