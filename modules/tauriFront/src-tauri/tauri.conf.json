{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EffiSuite",
  "version": "0.1.0",
  "identifier": "com.effisuite.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EffiSuite",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
