{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Suite",
  "version": "0.1.0",
  "identifier": "com.desktopsuite.core",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "dock",
        "title": "Dock",
        "url": "index.html",
        "width": 800,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focusable": true,
        "shadow": false,
        "center": false,
        "x": 560,
        "y": 1000
      },
      {
        "label": "widget-host",
        "title": "Widgets",
        "url": "widget-host.html",
        "width": 320,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focusable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "package-store",
        "title": "Package Store",
        "url": "package-store.html",
        "width": 900,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "settings.html",
        "width": 720,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "shadow": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
