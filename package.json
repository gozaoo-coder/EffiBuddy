{
  "name": "desktop-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri + Vue + Rust desktop enhancement suite (Core + plugin packages)",
  "scripts": {
    "dev": "pnpm --filter @desktop-suite/core dev",
    "build": "pnpm --filter @desktop-suite/core build",
    "tauri": "pnpm --filter @desktop-suite/core tauri",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vue-tsc": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
